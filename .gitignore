# Root gitignore
node_modules/
.env
*.log
dist/
build/

# Firebase & Secrets
*firebase-service-account*.json
firebase-service-account.json
backend/firebase-service-account.json
mobile/android/app/google-services.json

# Prisma generated
backend/node_modules/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/

# Web
web/node_modules/
!web/dist/
web/dist/*.map

# Widget — ignore generated source maps / intermediate files, but COMMIT the built bundle
widget/node_modules/
!widget/dist/
!widget/dist/widget.js
widget/dist/*.map
# widget/dist/widget.js is intentionally committed so /widget.js works without a build step

# OS
.DS_Store
Thumbs.db
