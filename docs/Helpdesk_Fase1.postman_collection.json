        {
          "name": "Refresh Token ✅",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Rotasi token: token lama dicabut, token baru diterbitkan. accessToken baru otomatis tersimpan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dapat token baru', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.refreshToken).to.be.a('string');",
                  "  // Token baru harus berbeda dari yang lama",
                  "  pm.expect(body.data.refreshToken).to.not.eql(pm.environment.get('refreshToken'));",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.environment.set('accessToken', body.data.accessToken);",
                  "  pm.environment.set('refreshToken', body.data.refreshToken);",
                  "  console.log('✅ Token diperbarui (rotasi)');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
