    {
      "name": "👥 User Management (Admin Only)",
      "item": [
        {
          "name": "GET /users — Daftar Semua User ✅",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Daftar semua user. Hanya bisa diakses admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mengembalikan array user', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.data.length).to.be.gte(3); // minimal 3 dari seed",
                  "});",
                  "pm.test('passwordHash tidak bocor', () => {",
                  "  const body = pm.response.json();",
                  "  body.data.forEach(u => pm.expect(u.passwordHash).to.be.undefined);",
                  "});",
                  "",
                  "// Simpan ID agent2 untuk tes berikutnya",
                  "const body = pm.response.json();",
                  "const agent2 = body.data.find(u => u.email === 'agent2@helpdesk.test');",
                  "if (agent2) pm.environment.set('agent2Id', agent2.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
