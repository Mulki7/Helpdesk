        {
          "name": "PATCH /users/:id — Nonaktifkan Agent ✅",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{newUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{newUserId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "description": "Nonaktifkan agent. Setelah ini, agent tidak bisa login."
          },
          "event": [
            {
              "listen": "test",
