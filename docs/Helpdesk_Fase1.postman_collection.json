  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Cek apakah server berjalan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response punya data.status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (Admin) ✅",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.test\",\n  \"password\": \"Admin123!\"\n}"
            },
            "description": "Login sebagai admin. Token otomatis disimpan ke environment variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dapat accessToken dan refreshToken', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.refreshToken).to.be.a('string');",
                  "  pm.expect(body.data.user.role).to.eql('ADMIN');",
                  "  pm.expect(body.data.user.passwordHash).to.be.undefined; // jangan bocor",
                  "});",
                  "",
                  "// Simpan token ke environment",
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.environment.set('accessToken', body.data.accessToken);",
                  "  pm.environment.set('refreshToken', body.data.refreshToken);",
                  "  pm.environment.set('adminId', body.data.user.id);",
                  "  console.log('✅ Token admin tersimpan');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Agent 1) ✅",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent1@helpdesk.test\",\n  \"password\": \"Agent123!\"\n}"
            },
            "description": "Login sebagai agent. Token agent tersimpan di agentToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Role adalah AGENT', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.user.role).to.eql('AGENT');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.environment.set('agentToken', body.data.accessToken);",
                  "  pm.environment.set('agentRefreshToken', body.data.refreshToken);",
                  "  pm.environment.set('agentId', body.data.user.id);",
                  "  console.log('✅ Token agent tersimpan');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
